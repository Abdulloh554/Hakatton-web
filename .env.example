# Copy this file to .env.local, fill in the values and keep .env.local out of git.

# --- Database ---------------------------------------------------------------
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@cluster0.gfxrr8f.mongodb.net/hakaton?retryWrites=true&w=majority&appName=Cluster0

# --- API --------------------------------------------------------------------
API_PORT=4000
# Comma-separated list of origins allowed to call the API directly.
WEB_URL=http://localhost:3000,http://localhost:3100
# Signs the anonymous session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Required by /api/admin/*. Generate with the same command as above.
ADMIN_API_KEY=

# --- Web (atlas app, port 3000) ---------------------------------------------
# Where the Next.js proxy forwards /api/* requests.
API_URL=http://127.0.0.1:4000
# Link back to the landing app from the atlas header.
NEXT_PUBLIC_LANDING_URL=http://localhost:3100

# --- Landing (marketing app, port 3100) -------------------------------------
# Where the landing page sends visitors to open the atlas.
NEXT_PUBLIC_ATLAS_URL=http://localhost:3000
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Telegram (optional) ----------------------------------------------------
# Leave empty to run the bot in setup mode instead of starting a poller.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_ADMIN_USER_ID=
